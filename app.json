{
  "expo": {
    "name": "UV Scout",
    "slug": "uvscout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/16af89d2-ff27-4f27-9586-517473700c63"
    },
    "android": {
      "package": "com.bravogroup.uvscout",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#F5F2EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "UV Scout",
      "shortName": "UV Scout",
      "themeColor": "#F5F2EC",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#F5F2EC"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#F5F2EC"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "16af89d2-ff27-4f27-9586-517473700c63"
      }
    },
    "owner": "bravogroup",
    "ios": {}
  }
}
