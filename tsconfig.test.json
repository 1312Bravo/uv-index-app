{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "node_modules/.cache/uv-scout-domain-tests"
  },
  "include": [
    "src/domain/forecast/forecastTypes.ts",
    "src/domain/forecast/getUvForecastAtTime.ts",
    "src/domain/uv/getUvCategory.ts",
    "src/domain/outing/calculateOutingForecast.ts",
    "src/domain/outing/getEndTimeSlots.ts",
    "src/domain/guidance/getHourlyUvGuidance.ts",
    "src/domain/guidance/getWhoGuidance.ts",
    "src/domain/guidance/getUvScoutInsight.ts"
  ]
}
